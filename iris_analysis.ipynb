# Iris Flower Data Analysis

import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv("Iris Dataset from Kaggle.csv")

print(df.head())
print(df.info())
print(df.isnull().sum())
print(df.describe())

print(df[['SepalLengthCm', 'SepalWidthCm', 'PetalLengthCm', 'PetalWidthCm']].agg(['min', 'max']))

print(df['Species'].value_counts())

print(df.groupby('Species')[[
    'SepalLengthCm',
    'SepalWidthCm',
    'PetalLengthCm',
    'PetalWidthCm'
]].mean())

avg_petal = df.groupby('Species')['PetalLengthCm'].mean()

avg_petal.plot(kind='bar')
plt.title('Average Petal Length by Species')
plt.xlabel('Species')
plt.ylabel('Average Petal Length (cm)')
plt.xticks(rotation=0)
plt.tight_layout()

plt.savefig('average_petal_length_by_species.png', dpi=300, bbox_inches='tight')
plt.show()
